    "type": "git",
    "url": "git+https://github.com/psyb0t/docker-auto-linux-desk.git"
  },
  "engines": { "node": ">=18" },
  "dependencies": { "mcp-remote": "0.1.38" },
  "publishConfig": { "access": "public" },
  "openclaw": {
    "extensions": ["./bin/cli.js"],
