# Copy to .env and pass with docker run --env-file .env.
AUTH_TOKEN=your-token-here
DESK_EXEC_ENABLED=true
DESK_SUDO_ENABLED=false
PUID=1000
# Omit PGID to use the same value as PUID.
PGID=1000
XVFB_RESOLUTION=1920x1080
XVFB_DEPTH=24
TZ=UTC
VNC_SHOW_CURSOR=true
HTTP_LISTEN_HOST=0.0.0.0
HTTP_LISTEN_PORT=8080
VNC_LISTEN_HOST=0.0.0.0
VNC_LISTEN_PORT=5900
LOG_LEVEL=INFO
# LOG_FILE=/userdata/desk.log
# KEYBINDINGS_FILE=/userdata/keymap.json
DESK_LAUNCH_LOG_DIR=/tmp/auto-linux-desk/launched
# AUTO_LINUX_DESK_PLUGINS=your_plugin
DESK_HOME=/home/desk
DESK_WRITABLE_DIRS=/userdata /recordings
DESK_BANNER=AUTO-LINUX-DESK
# DESK_HOOK_DIR=/etc/auto-linux-desk/entrypoint.d
