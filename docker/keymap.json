{
  "description": "The desktop's complete Openbox key map, in send_key notation. docker/configure-openbox.py writes it as the whole keyboard section of rc.xml; nothing from the stock Openbox bindings is kept. The default bindings avoid the Super (win) key and use ctrl+alt combinations, plus the usual Alt window shortcuts.",
  "bindings": [
    {"key": "ctrl+alt+left", "group": "Place", "description": "tile the focused window to the left half", "actions": [{"name": "UnmaximizeFull"}, {"name": "MoveResizeTo", "options": {"x": "0", "y": "0", "width": "50%", "height": "100%"}}]},
    {"key": "ctrl+alt+right", "group": "Place", "description": "tile the focused window to the right half", "actions": [{"name": "UnmaximizeFull"}, {"name": "MoveResizeTo", "options": {"x": "50%", "y": "0", "width": "50%", "height": "100%"}}]},
    {"key": "ctrl+alt+up", "group": "Place", "description": "tile the focused window to the top half", "actions": [{"name": "UnmaximizeFull"}, {"name": "MoveResizeTo", "options": {"x": "0", "y": "0", "width": "100%", "height": "50%"}}]},
    {"key": "ctrl+alt+down", "group": "Place", "description": "tile the focused window to the bottom half", "actions": [{"name": "UnmaximizeFull"}, {"name": "MoveResizeTo", "options": {"x": "0", "y": "50%", "width": "100%", "height": "50%"}}]},
    {"key": "ctrl+alt+u", "group": "Place", "description": "tile the focused window to the top-left quarter", "actions": [{"name": "UnmaximizeFull"}, {"name": "MoveResizeTo", "options": {"x": "0", "y": "0", "width": "50%", "height": "50%"}}]},
    {"key": "ctrl+alt+i", "group": "Place", "description": "tile the focused window to the top-right quarter", "actions": [{"name": "UnmaximizeFull"}, {"name": "MoveResizeTo", "options": {"x": "50%", "y": "0", "width": "50%", "height": "50%"}}]},
    {"key": "ctrl+alt+j", "group": "Place", "description": "tile the focused window to the bottom-left quarter", "actions": [{"name": "UnmaximizeFull"}, {"name": "MoveResizeTo", "options": {"x": "0", "y": "50%", "width": "50%", "height": "50%"}}]},
    {"key": "ctrl+alt+k", "group": "Place", "description": "tile the focused window to the bottom-right quarter", "actions": [{"name": "UnmaximizeFull"}, {"name": "MoveResizeTo", "options": {"x": "50%", "y": "50%", "width": "50%", "height": "50%"}}]},
    {"key": "ctrl+alt+c", "group": "Place", "description": "center the focused window", "actions": [{"name": "MoveResizeTo", "options": {"x": "center", "y": "center"}}]},
    {"key": "ctrl+alt+m", "group": "State", "description": "maximize the focused window, or restore it if it is maximized", "actions": [{"name": "ToggleMaximize"}]},
    {"key": "ctrl+alt+f", "group": "State", "description": "toggle fullscreen on the focused window", "actions": [{"name": "ToggleFullscreen"}]},
    {"key": "ctrl+alt+r", "group": "State", "description": "restore the focused window from maximized", "actions": [{"name": "UnmaximizeFull"}]},
    {"key": "ctrl+alt+n", "group": "State", "description": "minimize the focused window", "actions": [{"name": "Iconify"}]},
    {"key": "ctrl+alt+a", "group": "State", "description": "toggle always on top for the focused window", "actions": [{"name": "ToggleAlwaysOnTop"}]},
    {"key": "ctrl+alt+w", "group": "State", "description": "close the focused window", "actions": [{"name": "Close"}]},
    {"key": "alt+f4", "group": "State", "description": "close the focused window", "actions": [{"name": "Close"}]},
    {"key": "alt+tab", "group": "Focus", "description": "switch to the next window", "actions": [{"name": "NextWindow"}]},
    {"key": "alt+shift+tab", "group": "Focus", "description": "switch to the previous window", "actions": [{"name": "PreviousWindow"}]},
    {"key": "ctrl+alt+shift+left", "group": "Focus", "description": "focus the nearest window to the left", "actions": [{"name": "DirectionalCycleWindows", "options": {"direction": "left"}}]},
    {"key": "ctrl+alt+shift+right", "group": "Focus", "description": "focus the nearest window to the right", "actions": [{"name": "DirectionalCycleWindows", "options": {"direction": "right"}}]},
    {"key": "ctrl+alt+shift+up", "group": "Focus", "description": "focus the nearest window above", "actions": [{"name": "DirectionalCycleWindows", "options": {"direction": "up"}}]},
    {"key": "ctrl+alt+shift+down", "group": "Focus", "description": "focus the nearest window below", "actions": [{"name": "DirectionalCycleWindows", "options": {"direction": "down"}}]},
    {"key": "ctrl+alt+b", "group": "Focus", "description": "focus the browser", "actions": [{"name": "Execute", "options": {"command": "desk-focus --class navigator|firefox|camoufox|chrom|brave"}}]},
    {"key": "ctrl+alt+t", "group": "Focus", "description": "focus the terminal, or open one if none is running", "actions": [{"name": "Execute", "options": {"command": "desk-focus --class xterm|terminal --launch x-terminal-emulator"}}]},
    {"key": "ctrl+alt+1", "group": "Focus", "description": "focus window 1 (windows count in the order they opened)", "actions": [{"name": "Execute", "options": {"command": "desk-focus --slot 1"}}]},
    {"key": "ctrl+alt+2", "group": "Focus", "description": "focus window 2", "actions": [{"name": "Execute", "options": {"command": "desk-focus --slot 2"}}]},
    {"key": "ctrl+alt+3", "group": "Focus", "description": "focus window 3", "actions": [{"name": "Execute", "options": {"command": "desk-focus --slot 3"}}]},
    {"key": "ctrl+alt+4", "group": "Focus", "description": "focus window 4", "actions": [{"name": "Execute", "options": {"command": "desk-focus --slot 4"}}]},
    {"key": "ctrl+alt+5", "group": "Focus", "description": "focus window 5", "actions": [{"name": "Execute", "options": {"command": "desk-focus --slot 5"}}]},
    {"key": "ctrl+alt+6", "group": "Focus", "description": "focus window 6", "actions": [{"name": "Execute", "options": {"command": "desk-focus --slot 6"}}]},
    {"key": "ctrl+alt+7", "group": "Focus", "description": "focus window 7", "actions": [{"name": "Execute", "options": {"command": "desk-focus --slot 7"}}]},
    {"key": "ctrl+alt+8", "group": "Focus", "description": "focus window 8", "actions": [{"name": "Execute", "options": {"command": "desk-focus --slot 8"}}]},
    {"key": "ctrl+alt+9", "group": "Focus", "description": "focus window 9", "actions": [{"name": "Execute", "options": {"command": "desk-focus --slot 9"}}]},
    {"key": "ctrl+alt+shift+t", "group": "Open", "description": "open a new terminal", "actions": [{"name": "Execute", "options": {"command": "x-terminal-emulator"}}]},
    {"key": "ctrl+alt+d", "group": "Desktop", "description": "hide or show all windows", "actions": [{"name": "ToggleShowDesktop"}]},
    {"key": "ctrl+alt+space", "group": "Desktop", "description": "open the focused window's menu (move, resize, layer, close)", "actions": [{"name": "ShowMenu", "options": {"menu": "client-menu"}}]},
    {"key": "ctrl+alt+esc", "group": "Desktop", "description": "send the focused window to the back", "actions": [{"name": "Lower"}, {"name": "FocusToBottom"}, {"name": "Unfocus"}]},
    {"key": "ctrl+alt+shift+r", "group": "Desktop", "description": "reload the window manager config", "actions": [{"name": "Reconfigure"}]}
  ]
}
