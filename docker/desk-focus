#!/usr/bin/env python3
"""Focus a desktop window by its WM_CLASS or by the order windows opened in.

Usage:
  desk-focus --class REGEX [--launch COMMAND ...]
  desk-focus --slot N

--class focuses the most recently opened window whose WM_CLASS
(instance.Class, as wmctrl -l -x prints it) matches REGEX, case-insensitive.
When none matches and --launch is given, that command is started instead.
--slot focuses the Nth window, counting from 1 in the order the windows
opened (wmctrl's list order). The Openbox key map binds these; exit status
is 0 when a window was focused or a program started, 1 otherwise.
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys

from autolinuxdesk.windows import list_windows


def windows() -> list[tuple[str, str]]:
    """(id, WM_CLASS) of every normal window, in opening order. Windows on
    desktop -1 (panels, docks) are left out."""
    return [
        (window["id"], window["wm_class"]) for window in list_windows() if window["desktop"] != -1
    ]


def focus(window_id: str) -> None:
    subprocess.run(["wmctrl", "-i", "-a", window_id], check=True)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Focus a desktop window by class or opening order."
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument(
        "--class", dest="wm_class", help="regular expression matched against WM_CLASS"
    )
    group.add_argument("--slot", type=int, help="window number, from 1, in opening order")
    parser.add_argument(
        "--launch", nargs=argparse.REMAINDER, help="command to start when no window matches"
    )
    args = parser.parse_args()
    if args.slot is not None and args.slot < 1:
        parser.error("--slot must be at least 1")
    try:
        pattern = re.compile(args.wm_class, re.IGNORECASE) if args.wm_class is not None else None
    except re.error as error:
        parser.error(f"invalid --class regular expression: {error}")

    found = windows()
    if args.slot is not None:
        if not 1 <= args.slot <= len(found):
            return 1
        focus(found[args.slot - 1][0])
        return 0

    matches = [window_id for window_id, wm_class in found if pattern.search(wm_class)]
    if matches:
        focus(matches[-1])
        return 0
    if args.launch:
        subprocess.Popen(
            args.launch,
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main())
